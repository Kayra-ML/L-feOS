# =========================================================
#  LifeOS — Ortam Değişkenleri (.env)
#  Bu dosyayı GIT'E EKLEMEYİN! .gitignore'a ekleyin.
# =========================================================

# ── NOTION API TOKEN ─────────────────────────────────────
# https://www.notion.so/my-integrations adresinden alın.
# "New integration" oluşturun → "Internal Integration Token" kopyalayın.
NOTION_TOKEN=secret_BURAYA_NOTION_INTEGRATION_TOKEN_GIRIN

# ── PROJELER VERİTABANI ──────────────────────────────────
# Notion'da Projeler DB sayfasını açın → URL'deki 32 karakterlik ID'yi alın.
# Örn: https://notion.so/abc123...xyz/BURASI_DB_ID?v=...
# Ayrıca: Sayfada "..." > "Connect to" > Integration adınızı seçin!
PROJECTS_DB_ID=BURAYA_PROJELER_VERITABANI_ID_GIRIN

# ── RUTİNLER / GÖREVLER VERİTABANI ──────────────────────
# Yukarıdakiyle aynı adımları Rutinler DB için tekrarlayın.
ROUTINES_DB_ID=BURAYA_RUTINLER_VERITABANI_ID_GIRIN

# ── BACKEND SUNUCU AYARLARI ──────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=True
